# signal-engine — every environment variable the code actually reads.
# Copy to .env and uncomment only what you want to change. Each value shown is the built-in
# default, so an untouched copy of this file changes nothing. (.env is gitignored; this is not.)

# ── Server ───────────────────────────────────────────────────────────────────────────────────────
# PORT=4000
# Network interface to bind. Loopback by default ON PURPOSE: the dashboard has NO LOGIN and its
# routes include irreversible ones (purge-old, shutdown, bulk-delete).
# Setting 0.0.0.0 genuinely exposes all of that to your whole network with no password — there is
# no guard behind it that makes this safe (the Host header comes from the client, so it cannot be
# one). The server prints a warning on boot when you do. Only on a network you trust, and unset it
# when you are finished.
# HOST=127.0.0.1
# Run one full fetch cycle immediately on boot instead of waiting for the first scheduled run.
# INITIAL_FETCH=0

# ── Storage ──────────────────────────────────────────────────────────────────────────────────────
# SIGNAL_DB=data/signals.db
# CLIENTS_DIR=clients
# TECH_CSV=data/theirstack-technologies.csv
# WAPP_FP=data/webappanalyzer-fingerprints.json

# ── hiring.cafe transport + adaptive gate ────────────────────────────────────────────────────────
# Leave HC_TRANSPORT unset for the default (auto). "http" forces plain HTTP, "browser" forces
# Playwright. BROWSER_ENGINE=camoufox swaps the browser engine.
# HC_TRANSPORT=
# BROWSER_ENGINE=
# HC_HTTP_CONCURRENCY=24
# HC_HTTP_TIMEOUT_MS=20000
# HC_MAX_CONCURRENCY=6
# HC_BROWSER_TIMEOUT_MS=25000
# Consecutive clean pages before the gate widens again.
# HC_RAMP_AFTER=12
# Pause after the gate trips.
# HC_COOLDOWN_MS=15000
# HCORG_CHUNK=25
# HCORG_RETRIES=2

# ── Fetch pipeline ───────────────────────────────────────────────────────────────────────────────
# FETCH_SOURCE_CONCURRENCY=8
# Job-description scraping. UNSET MEANS UNLIMITED (every job carrying a detail URL) — the adaptive
# gate is what bounds real load. Set a number to cap it, or 0 to turn JD scraping off entirely.
# FETCH_DESC_MAX=
# FETCH_DESC_CONCURRENCY=
# VERIFY_CONCURRENCY=12

# ── Account checking ─────────────────────────────────────────────────────────────────────────────
# ACCOUNT_CONCURRENCY=8
# ACCOUNT_RETRIES=3
# ACCOUNT_MAX=10000
# Hours before a cached account result is re-fetched.
# ACCOUNT_CACHE_HOURS=12
# Same contract as FETCH_DESC_MAX — unset means unlimited, not 200.
# ACCOUNT_DESC_MAX=
# ACCOUNT_DESC_CONCURRENCY=

# ── ATS boards + signals ─────────────────────────────────────────────────────────────────────────
# ATS_TIMEOUT_MS=15000
# ATS_DISCOVERY_CONCURRENCY=6
# BOARDS_TIMEOUT_MS=15000
# SIGNAL_CHECK_CONCURRENCY=6
# SmartRecruiters returns postings without descriptions, so each one costs an extra request. Only the
# first N of a board get one; the rest are stored without. The engine logs a warning naming the number
# it skipped. Set to 0 to fetch no descriptions from SmartRecruiters at all.
# SR_DESC_MAX=200
# GDELT allows roughly one lookup every 5 seconds and the producer paces itself to match. Lower it
# only against a stub — against the real API a smaller gap gets the lane rate-limited, which the
# producer then reports as "feed unavailable".
# GDELT_GAP_MS=5200

# ── Diagnostics ──────────────────────────────────────────────────────────────────────────────────
# node:sqlite is SYNCHRONOUS: every query blocks the one thread that also serves the dashboard, so a
# slow query is not a slow page, it is a frozen app. This logs any reconcile step that holds the loop
# longer than N milliseconds — lower it when hunting "why did the app hang just then".
# RECONCILE_LOG_MS=250

# ── Contact ──────────────────────────────────────────────────────────────────────────────────────
# Your email, sent in the User-Agent to SEC EDGAR, crt.sh/Cert Spotter and the WARN feeds; unset skips EDGAR (SEC requires a contact).
# CONTACT_EMAIL=you@example.com

# ── Not an environment variable ──────────────────────────────────────────────────────────────────
# The Companies House API key is stored in the database via Settings in the dashboard, not here.
